#!/usr/bin/env bash
set -e

if [[ $(basename "$PWD") != "MGross21" ]]; then
    echo "Error: Run this script from the MGross21 directory."
    exit 1
fi

build() {
    local outdir=$1
    shift
    latexmk -g -pdf -interaction=nonstopmode -halt-on-error -outdir="$outdir" "$@" -silent
    latexmk -c -outdir="$outdir" "$@" -silent
}

mkdir -p output
build output resume.tex
build output -jobname=resume-inverted resume.tex
build output cv.tex

if [[ -d covers ]]; then
    find covers -name "*.tex" | while read -r texfile; do
        build "$(dirname "$texfile")" "$texfile"
        echo "Compiled $texfile"
    done
fi
